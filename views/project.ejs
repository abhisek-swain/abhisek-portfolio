<%- include('partials/head') %>

<section class="page-header project-header" style="--accent: <%= project.accent %>">
  <div class="container">
    <a href="/portfolio" class="back-link"><i class="bi bi-arrow-left"></i> All projects</a>
    <div class="d-flex align-items-center gap-3 mt-3 mb-2">
      <div class="icon-box lg"><i class="bi <%= project.icon %>"></i></div>
      <span class="chip"><%= project.category %></span>
    </div>
    <h1><%= project.title %></h1>
    <p class="lead-soft"><%= project.summary %></p>
  </div>
</section>

<section class="section pt-0">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-8">
        <div class="detail-block reveal">
          <h2>Overview</h2>
          <p><%= project.description %></p>
        </div>
        <div class="detail-block reveal">
          <h2>Key features</h2>
          <ul class="check-list">
            <% project.features.forEach(function(f) { %><li><%= f %></li><% }) %>
          </ul>
        </div>
      </div>
      <div class="col-lg-4">
        <aside class="side-card reveal">
          <h3>Project info</h3>
          <dl>
            <dt>Category</dt><dd><%= project.category %></dd>
            <dt>My role</dt><dd><%= project.role %></dd>
            <dt>Tech stack</dt>
            <dd class="tech-list mt-2"><% project.tech.forEach(function(t) { %><span><%= t %></span><% }) %></dd>
          </dl>
          <div class="d-grid gap-2 mt-4">
            <% if (project.liveUrl) { %>
              <a href="<%= project.liveUrl %>" target="_blank" rel="noopener" class="btn btn-glow"><i class="bi bi-box-arrow-up-right me-1"></i> Live site</a>
            <% } %>
            <% if (project.repoUrl) { %>
              <a href="<%= project.repoUrl %>" target="_blank" rel="noopener" class="btn btn-ghost"><i class="bi bi-github me-1"></i> Source code</a>
            <% } %>
            <a href="mailto:<%= site.email %>?subject=<%= encodeURIComponent('About your project: ' + project.title) %>" class="btn btn-ghost"><i class="bi bi-envelope me-1"></i> Ask about this project</a>
          </div>
        </aside>
      </div>
    </div>

    <div class="pager">
      <a href="/portfolio/<%= prev.slug %>" class="pager-link">
        <span><i class="bi bi-arrow-left"></i> Previous</span>
        <strong><%= prev.title %></strong>
      </a>
      <a href="/portfolio/<%= next.slug %>" class="pager-link text-end">
        <span>Next <i class="bi bi-arrow-right"></i></span>
        <strong><%= next.title %></strong>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
