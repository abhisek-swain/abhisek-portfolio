<nav class="navbar navbar-expand-lg fixed-top site-nav" id="siteNav">
  <div class="container">
    <a class="navbar-brand brand" href="/">
      <span class="brand-mark"><%= site.shortName %></span>
      <span class="brand-text"><%= site.name %><span class="brand-dot">.</span></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list"></i>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <% site.nav.forEach(function(item) {
             const active = item.url === '/' ? currentPath === '/' : currentPath.startsWith(item.url); %>
          <li class="nav-item">
            <a class="nav-link <%= active ? 'active' : '' %>" href="<%= item.url %>" <%= active ? 'aria-current=page' : '' %>><%= item.label %></a>
          </li>
        <% }) %>
        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
          <a class="btn btn-glow btn-sm" href="mailto:<%= site.email %>"><i class="bi bi-envelope-paper me-1"></i> Hire me</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
