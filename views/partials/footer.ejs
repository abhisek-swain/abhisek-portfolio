  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="row g-4 align-items-center">
        <div class="col-md-5">
          <a class="brand mb-2 d-inline-flex" href="/">
            <span class="brand-mark"><%= site.shortName %></span>
            <span class="brand-text"><%= site.name %><span class="brand-dot">.</span></span>
          </a>
          <p class="text-soft small mb-0"><%= site.tagline %></p>
        </div>
        <div class="col-md-4">
          <ul class="footer-links">
            <% site.nav.forEach(function(item) { %>
              <li><a href="<%= item.url %>"><%= item.label %></a></li>
            <% }) %>
          </ul>
        </div>
        <div class="col-md-3 text-md-end">
          <div class="socials justify-content-md-end">
            <% site.socials.filter(s => s.url).forEach(function(s) { %>
              <a href="<%= s.url %>" aria-label="<%= s.label %>" <%= s.url.startsWith('http') ? 'target=_blank rel=noopener' : '' %>><i class="bi <%= s.icon %>"></i></a>
            <% }) %>
          </div>
          <a class="footer-mail" href="mailto:<%= site.email %>"><%= site.email %></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; <%= year %> <%= site.name %>. All rights reserved.</span>
        <span class="mono"><%= site.footerNote %></span>
      </div>
    </div>
  </footer>

  <div class="toast-copy" id="copyToast" role="status" aria-live="polite"><i class="bi bi-check2-circle me-2"></i>Email copied to clipboard</div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
